# MillionTasks Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to version control

# ====================
# DATABASE (Supabase)
# ====================
# Get these from your Supabase project settings:
# https://app.supabase.com/project/_/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_KEY=your-supabase-service-key-here

# ====================
# MESSAGING PLATFORMS
# ====================

# Telegram Bot Configuration
# Create a bot via @BotFather on Telegram
# Commands to set up:
# 1. Message @BotFather
# 2. Send /newbot
# 3. Choose a name and username
# 4. Copy the token provided
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz123456789
TELEGRAM_WEBHOOK_SECRET=your-webhook-secret-here

# Signal Bot Configuration (Future)
# SIGNAL_PHONE_NUMBER=+1234567890
# SIGNAL_PASSWORD=your-signal-password

# Slack Bot Configuration (Future)
# SLACK_BOT_TOKEN=xoxb-your-token
# SLACK_APP_TOKEN=xapp-your-app-token
# SLACK_SIGNING_SECRET=your-signing-secret

# ====================
# AI SERVICES
# ====================

# Anthropic Claude API
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-haiku-20240307

# OpenAI API (Alternative/Fallback)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# AI Provider Selection (anthropic | openai)
AI_PROVIDER=openai

# ====================
# APPLICATION SETTINGS
# ====================

# Server Configuration
NODE_ENV=development
PORT=3000
HOST=localhost

# API Configuration
API_PREFIX=/api
API_VERSION=v1

# Webhook URLs (for production)
# These will be your public URLs for receiving messages
TELEGRAM_WEBHOOK_URL=https://your-domain.com/webhooks/telegram
# SIGNAL_WEBHOOK_URL=https://your-domain.com/webhooks/signal
# SLACK_WEBHOOK_URL=https://your-domain.com/webhooks/slack

# ====================
# FEATURES
# ====================

# Feature Flags
ENABLE_NATURAL_LANGUAGE=true
ENABLE_COMMAND_FALLBACK=true
ENABLE_AUTO_REMINDERS=true
ENABLE_TIMEZONE_DETECTION=true
ENABLE_VOICE_MESSAGES=false
ENABLE_RECURRING_TASKS=false

# AI Configuration
AI_MAX_TOKENS=500
AI_TEMPERATURE=0.3
AI_INTENT_CONFIDENCE_THRESHOLD=0.7

# ====================
# NOTIFICATION SETTINGS
# ====================

# Default reminder times (in minutes before due date)
DEFAULT_REMINDER_MINUTES=15
DAILY_SUMMARY_TIME=09:00

# ====================
# LOGGING & MONITORING
# ====================

LOG_LEVEL=info
# Options: error | warn | info | debug | trace

# Sentry (Optional - for error tracking in production)
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ====================
# SECURITY
# ====================

# Session Configuration
SESSION_SECRET=your-session-secret-here

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# CORS Settings (for web dashboard if needed)
CORS_ORIGIN=http://localhost:3001

# ====================
# DEVELOPMENT
# ====================

# Debug Settings
DEBUG=false
DEBUG_SQL=false

# Testing
TEST_USER_TELEGRAM_ID=your-telegram-username
TEST_USER_SIGNAL_NUMBER=+1234567890